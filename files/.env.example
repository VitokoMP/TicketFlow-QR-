# ==========================================
# Ticket Flow QR - Configuración
# ==========================================

# DEMO_MODE: usa datos fake para testing/demo
# true = modo demo (sin WordPress)
# false = modo producción (WordPress real)
DEMO_MODE=true

# WordPress API (solo en modo DEMO_MODE=false)
# WP_API_ROOT=/wp-json/
# WP_NONCE=tu_nonce_aqui

# Netlify/Build (auto-configurado en deploy)
# NODE_ENV=production
