    ticket.meta_value AS ticket_number,
    scans.scan_status AS scan_status,
    e.event_title,
    e.start_datetime,
    e.end_datetime
FROM wp_posts a
LEFT JOIN wp_postmeta name ON name.post_id = a.ID AND name.meta_key = 'ea_name'
LEFT JOIN wp_postmeta email ON email.post_id = a.ID AND email.meta_key = 'ea_email'
LEFT JOIN wp_postmeta phone ON phone.post_id = a.ID AND phone.meta_key = 'ea_phone'
LEFT JOIN wp_postmeta event ON event.post_id = a.ID AND event.meta_key = 'ea_event_id'
LEFT JOIN wp_postmeta ticket ON ticket.post_id = a.ID AND ticket.meta_key = 'ea_ticket_no'
LEFT JOIN wp_ticketflow_scans scans ON scans.qr_code = a.post_name
LEFT JOIN active_events e ON e.event_id = CAST(event.meta_value AS UNSIGNED)
WHERE a.post_type = 'mep_events_attendees'
AND e.event_id IS NOT NULL;

UPDATE wp_ticketflow_scans
SET scan_status = 'scanned', updated_at = NOW()
WHERE qr_code = 'qr_code_value'
AND event_id IN (SELECT event_id FROM active_events);

DROP VIEW IF EXISTS active_events;

CREATE VIEW active_events AS
SELECT
    e.ID AS event_id,
    e.post_title AS event_title,
    STR_TO_DATE(start_meta.meta_value, '%Y-%m-%d %H:%i:%s') AS start_datetime,
    STR_TO_DATE(end_meta.meta_value, '%Y-%m-%d %H:%i:%s') AS end_datetime
FROM wp_posts e
LEFT JOIN wp_postmeta start_meta ON start_meta.post_id = e.ID AND start_meta.meta_key = 'event_start_datetime'
LEFT JOIN wp_postmeta end_meta ON end_meta.post_id = e.ID AND end_meta.meta_key = 'event_end_datetime'
WHERE e.post_type = 'mep_events' 
AND e.post_status = 'publish'
AND STR_TO_DATE(start_meta.meta_value, '%Y-%m-%d %H:%i:%s') <= NOW()
AND STR_TO_DATE(end_meta.meta_value, '%Y-%m-%d %H:%i:%s') >= NOW();

DROP VIEW IF EXISTS active_events;

UPDATE wp_posts e
SET e.post_status = 'finished'
WHERE e.ID IN (SELECT event_id FROM active_events);
 